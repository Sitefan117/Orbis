# Configuration publique facultative du pilote Supabase.
# Ces deux valeurs peuvent être présentes dans le site public grâce aux règles RLS.
# Ne jamais placer de clé sb_secret_... dans ce fichier ou dans GitHub Pages.
PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre-cle-publique

# Utilisée uniquement par `npm run supabase:backup`. Ne jamais préfixer cette
# valeur par PUBLIC_ et ne jamais la committer.
ORBIS_SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:mot-de-passe@hote:5432/postgres
